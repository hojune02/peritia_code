# npm run dev and npm start load .env automatically. Never commit real secrets.
# For npm run dev:
APP_ORIGIN=http://localhost:5173
# Generate using: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3001
# Leave both empty to run password login without Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production uses Gemini; local development may still use Ollama.
# Set NODE_ENV=production only behind HTTPS, with APP_ORIGIN=https://your-domain.
# Local compiled-app testing: leave NODE_ENV unset, set APP_ORIGIN=http://localhost:3001.
DATABASE_URL=postgresql://peritia:peritia_local_only@127.0.0.1:5433/peritia
REDIS_URL=redis://127.0.0.1:6380

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Use "free" until the Gemini project has billing attached.
GEMINI_BILLING_TIER=free
# Keep these synchronized with Google's published prices for cost reporting.
GEMINI_INPUT_USD_PER_MILLION=0.10
GEMINI_OUTPUT_USD_PER_MILLION=0.40
# Change this label whenever the model or prompt behavior changes, invalidating cache safely.
AI_MODEL_REVISION=local-qwen2.5-coder-7b-v1

AI_PROMPT_VERSION=explanation-v1
AI_CONTEXT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=600
AI_TIMEOUT_MS=120000
AI_WORKER_CONCURRENCY=1

GITHUB_TOKEN=
GITHUB_CACHE_MODE=memory
# Optional GitHub App replacement for the PAT. Store the PEM with escaped newlines.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_TEST_MODE=true
BILLING_ENABLED=false
PAID_MONTHLY_ALLOWANCE=100
APP_URL=http://localhost:5173
POSTGRES_PASSWORD=
