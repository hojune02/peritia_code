{
  "name": "peritia",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "npm run start:api",
    "start:api": "node --env-file-if-exists=.env dist/server/api.mjs",
    "start:worker": "node --env-file-if-exists=.env dist/server/worker.mjs",
    "test": "GITHUB_CACHE_MODE=memory node scripts/test-core.mjs",
    "test:integration": "node --env-file-if-exists=.env scripts/test-integration.mjs",
    "test:ai": "node --env-file-if-exists=.env scripts/evaluate-ai.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-postgres.mjs",
    "staging:grant": "node --env-file-if-exists=.env scripts/grant-staging-credits.mjs",
    "ai:costs": "node --env-file-if-exists=.env scripts/report-ai-costs.mjs"
  },
  "dependencies": {
    "bullmq": "^6.3.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.1.0",
    "lucide-react": "1.31.0",
    "pg": "^8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
