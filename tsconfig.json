{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "src",
    "app",
    "components",
    "hooks",
    "lib",
    "server",
    "tests",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".dev", ".test-build"]
}
